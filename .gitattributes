* text=auto

# Unity YAML assets — merge with UnityYAMLMerge (see README)
*.unity           merge=unityyamlmerge eol=lf
*.prefab          merge=unityyamlmerge eol=lf
*.asset           merge=unityyamlmerge eol=lf
*.mat             merge=unityyamlmerge eol=lf
*.anim            merge=unityyamlmerge eol=lf
*.controller      merge=unityyamlmerge eol=lf
*.overrideController merge=unityyamlmerge eol=lf
*.physicMaterial  merge=unityyamlmerge eol=lf
*.physicsMaterial merge=unityyamlmerge eol=lf
*.playable        merge=unityyamlmerge eol=lf
*.mask            merge=unityyamlmerge eol=lf
*.terrainlayer    merge=unityyamlmerge eol=lf
*.meta            text eol=lf

# Source
*.cs      text diff=csharp eol=lf
*.shader  text eol=lf
*.shadergraph text eol=lf
*.hlsl    text eol=lf
*.cginc   text eol=lf
*.uss     text eol=lf
*.uxml    text eol=lf
*.json    text eol=lf
*.md      text eol=lf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.tga   binary
*.psd   binary
*.tif   binary
*.exr   binary
*.hdr   binary
*.fbx   binary
*.obj   binary
*.blend binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.mp4   binary
*.ttf   binary
*.otf   binary
*.dll   binary
*.so    binary
*.dylib binary
*.a     binary
*.cubemap binary
*.unitypackage binary
