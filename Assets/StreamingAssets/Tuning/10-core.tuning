# Hype Swarm — core tuning
#
# External config, not baked into the build (spec §13.3). Edit this file next to the built
# executable and restart; no rebuild needed. A local override layer lives in
# <persistentDataPath>/Tuning and wins over anything here.
#
# Format: one "key = value" per line, '#' starts a comment. Numbers are parsed
# invariant-culture, so the decimal separator is always '.' regardless of system locale.
# Comma-separated lists are read as curves / per-tier values.
#
# Files in a directory load in filename order — hence the numeric prefix.

# --- Session ------------------------------------------------------------------------
# Target run length in seconds, from first spawn to the boss dying (spec §3, ~60 minutes).
session.target_length            = 3600

# --- Placeholders --------------------------------------------------------------------
# Real curves arrive with the wave director in Phase 2 step 8. These exist so the loader
# has something to read and the layering is exercised end to end.
placeholder.float                = 1.5
placeholder.int                  = 7
placeholder.bool                 = true
placeholder.curve                = 0, 0.5, 1.25, 2

# --- Stats ---------------------------------------------------------------------------
# Starting values before champion growth, items, or augments (spec §5.6).
#
# Soft caps are the K in "effect = value / (value + K)" for the stats that derive
# asymptotically (§5.6.2), so each one is the amount of that stat which buys half its
# asymptote: 100 damage reduction removes 50% of incoming damage, 300 removes 75%, and no
# amount ever removes all of it. Stats are never capped; the effect is derived instead.
#
# Every stat is listed. A stat missing from here falls back to a compiled default and is
# reported by the validation window, because half the balance living in a file and half in
# a constant is the discrepancy nobody finds by reading.

stat.max_health.base             = 100
stat.health_regen.base           = 1
stat.damage.base                 = 10
stat.penetration.base            = 0
stat.pickup_radius.base          = 3

stat.damage_reduction.base       = 0
stat.damage_reduction.soft_cap   = 100

stat.haste.base                  = 0
stat.haste.soft_cap              = 100

stat.move_speed.base             = 0
stat.move_speed.soft_cap         = 100

stat.dodge.base                  = 0
stat.dodge.soft_cap              = 100

stat.lifesteal.base              = 0
stat.lifesteal.soft_cap          = 100

stat.slow_resistance.base        = 0
stat.slow_resistance.soft_cap    = 100

# --- Combat --------------------------------------------------------------------------
# The numbers a fight needs that are not stats.
#
# The regen delay is what stops health regeneration being a stat you can stand in the
# swarm and win with, and it is what pays kiting back for the time it costs (§5.5.4):
# the space a dash buys is the space that heals you.

combat.regen_delay               = 5
combat.revive_health_fraction    = 0.5

# --- Abilities -----------------------------------------------------------------------
# passive_tick_interval is a performance number, not a balance one: passive effects are
# authored as rates and multiplied by it, so retuning it for frame time does not change
# what a passive does per second.
ability.passive_tick_interval    = 0.25
ability.slowed_cast_speed        = 0.4
ability.rooted_cast_ceiling      = 0.6
